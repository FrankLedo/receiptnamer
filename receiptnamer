# ---------------------------------------------------------------------------
watch_run() {
  local -a files
  files=("${(@f)$(find_scanned)}")
  local found=0 f

  for f in "${files[@]}"; do
    [[ -f "$f" ]] || continue
    found=1
    process_pdf "$f"
  done

  (( found )) && print "\n$renamed renamed, $unchanged unchanged, $skipped skipped"
}

# ---------------------------------------------------------------------------
# Load backend/model selection from config into globals. Defaults to the
# local Ollama backend so receipts stay on-device unless configured otherwise.
load_llm_config() {
  if [[ -f "$CONFIG" ]]; then
    local vals
    vals=$(python3 - "$CONFIG" <<'PYEOF'
import sys, json
try:
    c = json.load(open(sys.argv[1]))
except Exception:
    c = {}
print(c.get("backend", "claude"))
print(c.get("model", "qwen2.5:7b"))
print(c.get("ollama_host", "http://localhost:11434"))
PYEOF
)
    BACKEND="${${(f)vals}[1]}"
    MODEL="${${(f)vals}[2]}"
    OLLAMA_HOST="${${(f)vals}[3]}"
  fi
  : "${BACKEND:=claude}"
  : "${MODEL:=qwen2.5:7b}"
  : "${OLLAMA_HOST:=http://localhost:11434}"
}

# Call the local Ollama HTTP API. Echoes the raw model response on stdout;
# returns non-zero if the server is unreachable or returns an error, which
# the caller treats as "skip and retry" rather than a bad name.
ollama_generate() {
  local prompt="$1"
  python3 - "$OLLAMA_HOST" "$MODEL" "$prompt" <<'PYEOF'
import sys, json, urllib.request
host, model, prompt = sys.argv[1], sys.argv[2], sys.argv[3]
body = json.dumps({
    "model": model,
    "prompt": prompt,
    "stream": False,
    "options": {"temperature": 0},
}).encode()
try:
    req = urllib.request.Request(
        host.rstrip("/") + "/api/generate", data=body,
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=120) as r:
        data = json.load(r)
    sys.stdout.write(data.get("response", ""))
except Exception as e:
    print(f"ollama error: {e}", file=sys.stderr)
    sys.exit(1)
PYEOF
}

# Generate a filename (no extension) from receipt text using the configured
# backend. Echoes the cleaned filename on success. Returns non-zero only when
# the backend itself fails (distinct from an empty/garbage name).
generate_name() {
  local text="$1" scan_date="$2"
  local prompt="You name scanned receipt files. Output ONLY the filename: no extension, no path, no quotes, no explanation, no square brackets.

Format: YYYY-MM-DD - Vendor
You may append ' - short context' only when it is clearly useful (e.g. ' - dinner').

Rules:
- Find the date IN the receipt text and use it. Only if there is truly no date in the text, use this fallback: $scan_date
- Use the real merchant/vendor name in Title Case with normal spaces. Never use ALL CAPS or underscores. Fix obvious OCR typos in the vendor name.

Example of a correct answer: 2026-01-18 - Samurai Sushi - dinner

Receipt text:
$text"

  local raw
  case "$BACKEND" in
    claude)
      raw=$(claude --print "$prompt" 2>/dev/null) || return 1
      ;;
    ollama)
      raw=$(ollama_generate "$prompt") || return 1
      ;;
    *)
      print "Unknown backend: $BACKEND (expected 'ollama' or 'claude')" >&2
      return 1
      ;;
  esac

  print -r -- "$raw" \
    | tr -d '\n\r' \
    | sed 's|[/\\:*?"<>|]||g' \
    | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'
}

# Fire a macOS notification at most once per run when the backend is down.
notify_backend_failure() {
  (( NOTIFIED )) && return
  NOTIFIED=1
  osascript -e 'display notification "Local model unreachable — receipt left unrenamed, will retry." with title "receiptnamer"' 2>/dev/null || true
}

# ---------------------------------------------------------------------------
process_pdf() {
  local f="$1"
  local base="${f:t}"

  local tmpfile
  tmpfile=$(mktemp "${TMPDIR:-/tmp}/receiptnamer-XXXXXX")
  ocrmypdf --skip-text --quiet "$f" "$tmpfile" 2>/dev/null || cp "$f" "$tmpfile"

  local text
  text=$(pdftotext "$tmpfile" - 2>/dev/null) || true
  text="${text:0:3000}"

  if [[ -z "${text// /}" ]]; then
    print "NO TEXT   $base"
    (( skipped++ )) || true
    return
  fi

  # File creation date = scan date; used as fallback when the receipt has no legible date
  local scan_date
  scan_date=$(stat -f "%SB" -t "%Y-%m-%d" "$f" 2>/dev/null) || scan_date=$(date +%Y-%m-%d)

  local newname
  if ! newname=$(generate_name "$text" "$scan_date"); then
    # Backend call failed (e.g. Ollama server unreachable). Leave the file
    # unrenamed; the watcher will retry on its next pass. Notify once per run.
    notify_backend_failure
    print "SKIP      $base (backend '$BACKEND' unreachable)"
    (( skipped++ )) || true
    return
  fi

  if [[ -z "$newname" ]]; then
    print "NO NAME   $base"
    (( skipped++ )) || true
    return
  fi

  local dir="${f:h}"
  local target="$dir/$newname.pdf"

  if [[ "$target" == "$f" ]]; then
    print "UNCHANGED $base"
    (( unchanged++ )) || true
    return
  fi

  if [[ -f "$target" ]]; then
    local n=2
    while [[ -f "$dir/$newname ($n).pdf" ]]; do (( n++ )); done
    target="$dir/$newname ($n).pdf"
  fi

  local tag="RENAME "
  (( DRY_RUN )) && tag="DRY RUN"
  print "$tag   $base"
  print "        → ${target:t}"

  if (( !DRY_RUN )); then
    if mv "$f" "$target" 2>/dev/null; then
      # Direct rename: preserves creation date (same-filesystem rename syscall)
      (( renamed++ )) || true
    elif cp "$tmpfile" "$target" 2>/dev/null; then
      # iCloud from launchd: cp OCR'd temp, trash original via Finder
      osascript -e "tell application \"Finder\" to move POSIX file \"$f\" to trash" 2>/dev/null || rm -f "$f" 2>/dev/null
      (( renamed++ )) || true
    else
      # Last resort: Finder rename (no OCR layer, but gets a good name)
      osascript -e "tell application \"Finder\" to set name of (POSIX file \"$f\" as alias) to \"${target:t}\"" 2>/dev/null \
        && (( renamed++ )) || true
    fi
  fi
  rm -f "$tmpfile"
}

# ---------------------------------------------------------------------------
# Main
DRY_RUN=0
PATHS=()
WATCH_RUN=0

for arg in "$@"; do
  case "$arg" in
    --dry-run|-n)          DRY_RUN=1 ;;
    --init)                init_config; exit 0 ;;
    --install-quickaction) install_quickaction; exit 0 ;;
    --install-watcher)     install_watcher; exit 0 ;;
    --watch-run)           WATCH_RUN=1 ;;
    --help|-h)             usage; exit 0 ;;
    *)                     PATHS+=("$arg") ;;
  esac
done

load_llm_config

# Core deps are always required; the model backend adds its own.
deps=(ocrmypdf pdftotext python3)
case "$BACKEND" in
  claude) deps+=(claude) ;;
  ollama) ;;  # talks to the Ollama HTTP API via python3 (already required)
  *) print "Error: unknown backend '$BACKEND' in $CONFIG (expected 'ollama' or 'claude')" >&2; exit 1 ;;
esac
for dep in $deps; do
  if ! command -v "$dep" &>/dev/null; then
    print "Error: $dep not found on PATH" >&2
    exit 1
  fi
done

renamed=0
unchanged=0
skipped=0
NOTIFIED=0

if (( WATCH_RUN )); then
  watch_run
  exit 0
fi

if (( ${#PATHS} == 0 )); then
  usage >&2
  exit 1
fi

local expanded
for inputpath in "${PATHS[@]}"; do
  if [[ "$inputpath" == *[\*\?\[]* ]]; then
    expanded=( ${~inputpath}(N) )
  else
    expanded=( "$inputpath" )
  fi
  if (( ${#expanded} == 0 )); then
    print "Not found: $inputpath" >&2
    continue
  fi
  for item in "${expanded[@]}"; do
    if [[ -d "$item" ]]; then
      for f in "$item"/*.pdf(N) "$item"/*.PDF(N); do
        [[ -f "$f" ]] || continue
        process_pdf "$f"
      done
    elif [[ -f "$item" ]]; then
      process_pdf "$item"
    fi
  done
done

print "\n$renamed renamed, $unchanged unchanged, $skipped skipped"
