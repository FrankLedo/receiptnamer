#!/bin/zsh
# receiptnamer — OCR and rename scanned receipts using Claude

export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
SCRIPT="${0:A}"
CONFIG="${RECEIPTNAMER_CONFIG:-$HOME/.config/receiptnamer/config.json}"

# ---------------------------------------------------------------------------
usage() {
  print "Usage:"
  print "  receiptnamer [--dry-run] <file|directory> [...]"
  print "  receiptnamer --init                 Create starter config"
  print "  receiptnamer --install-quickaction  Install Finder Quick Action"
  print "  receiptnamer --install-watcher      Install automatic background watcher"
}

# ---------------------------------------------------------------------------
# Find Scanned Document PDFs across all watch_dirs; print one path per line.
find_scanned() {
  if [[ ! -f "$CONFIG" ]]; then
    print "Config not found: $CONFIG" >&2
    print "Run: receiptnamer --init" >&2
    return 1
  fi
  python3 - "$CONFIG" <<'PYEOF'
import sys, os, glob, json

config_file = sys.argv[1]
try:
    with open(config_file) as f:
        config = json.load(f)
except Exception as e:
    print(f"Error reading config: {e}", file=sys.stderr)
    sys.exit(1)

for pattern in config.get("watch_dirs", []):
    expanded = os.path.expanduser(pattern)
    for d in sorted(glob.glob(expanded)):
        if not os.path.isdir(d):
            continue
        for f in sorted(glob.glob(os.path.join(d, "Scanned Document*.pdf")) +
                        glob.glob(os.path.join(d, "Scanned Document*.PDF"))):
            if os.path.isfile(f):
                print(f)
PYEOF
}

# Kept for --install-watcher: resolves dirs for display only.
resolve_dirs() {
  if [[ ! -f "$CONFIG" ]]; then
    print "Config not found: $CONFIG" >&2
    return 1
  fi
  python3 - "$CONFIG" <<'PYEOF'
import sys, os, glob, json
config_file = sys.argv[1]
with open(config_file) as f:
    config = json.load(f)
for pattern in config.get("watch_dirs", []):
    expanded = os.path.expanduser(pattern)
    for m in sorted(glob.glob(expanded)):
        if os.path.isdir(m):
            print(m)
PYEOF
}

# ---------------------------------------------------------------------------
init_config() {
  if [[ -f "$CONFIG" ]]; then
    print "Config already exists: $CONFIG"
    print "Edit it to change your receipts folders."
    return
  fi
  mkdir -p "${CONFIG:h}"

  local icloud="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
  local default_dir
  local year=$(date +%Y)
  if [[ -d "$icloud" ]]; then
    default_dir="~/Library/Mobile Documents/com~apple~CloudDocs/Files/$year/Receipts and Manuals"
  else
    default_dir="~/Documents/Receipts"
  fi

  python3 - "$CONFIG" "$default_dir" <<'PYEOF'
import sys, json
config_file, default_dir = sys.argv[1], sys.argv[2]
config = {
    "watch_dirs": [default_dir],
    "backend": "claude",
    "model": "qwen2.5:7b",
}
with open(config_file, 'w') as f:
    json.dump(config, f, indent=2)
    f.write('\n')
PYEOF

  print "Created: $CONFIG"
  print ""
  print "watch_dirs supports shell globs. Update the year in January"
  print "or use '*' to match all year folders."
  print ""
  print "Edit the path if your receipts folder is somewhere else:"
  print "  $CONFIG"
}

